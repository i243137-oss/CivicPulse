# ═══════════════════════════════════════════════════════════════════════
#  CivicPulse — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════
#  Copy this file to .env and fill in real values.
#  NEVER commit the .env file — only .env.example is tracked.
# ═══════════════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────────────
APP_NAME="CivicPulse API"
APP_ENV=development                # development | staging | production
DEBUG=true

# ─── Ports ────────────────────────────────────────────────────────────
FRONTEND_PORT=80
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ─── Image Tag (for production Compose) ──────────────────────────────
IMAGE_TAG=latest

# ─── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=civicpulse_secret_pass
POSTGRES_DB=civicpulse

# ─── Redis ────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── AI Triage Provider ───────────────────────────────────────────────
# Options: "rules" | "simulated" | "llm" | "ollama"
TRIAGE_PROVIDER=rules
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# ─── Compose Project ──────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=civicpulse
