# CivicPulse backend — Phase 1 environment variables.
# Database, Redis and AI provider variables are introduced in Phase 2-4
# and intentionally do not appear here yet.

APP_NAME=CivicPulse API
ENVIRONMENT=development
DEBUG=true

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# Database — PostgreSQL 16
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=civicpulse
# Optional full DATABASE_URL override:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/civicpulse
