# CivicPulse backend — Phase 1 environment variables.
# Database, Redis and AI provider variables are introduced in Phase 2-4
# and intentionally do not appear here yet.

APP_NAME=CivicPulse API
ENVIRONMENT=development
DEBUG=true

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# ─── Database (PostgreSQL 16) ─────────────────────────────────────────
# WARNING: The default credentials below (postgres/postgres) are STRICTLY FOR
# LOCAL DEVELOPMENT AND TESTING ONLY.
# NEVER deploy with these credentials to staging, production, or public networks.
# In production, use strong randomly generated passwords and dedicated users.

# Use POSTGRES_HOST=postgres when running inside Docker Compose
# Use POSTGRES_HOST=localhost (or POSTGRES_SERVER=localhost) when running on host machine
POSTGRES_HOST=localhost
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=civicpulse

# Optional explicit DATABASE_URL override:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/civicpulse

# ─── Redis (Cache & Rate Limiting) ────────────────────────────────────
# Use REDIS_HOST=redis when running inside Docker Compose
# Use REDIS_HOST=localhost when running on host machine
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STATS_CACHE_TTL=30
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
# Optional explicit REDIS_URL override:
# REDIS_URL=redis://localhost:6379/0
