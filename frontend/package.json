{
  "name": "civicpulse-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "CivicPulse — React TypeScript frontend for civic issue reporting",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
