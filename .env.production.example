# ═══════════════════════════════════════════════════════════════════════
#  CivicPulse — Production Environment Configuration (.env.production)
# ═══════════════════════════════════════════════════════════════════════
#  Instructions:
#    1. Copy this file to .env on your production deployment host:
#         cp .env.production.example .env
#    2. Fill in production secrets (PostgreSQL password, API keys, etc.).
#    3. Set IMAGE_TAG to the deployed immutable Git commit SHA or release tag.
#    4. NEVER commit the real .env file to Git history.
# ═══════════════════════════════════════════════════════════════════════

# ─── Application Mode ──────────────────────────────────────────────────
APP_NAME="CivicPulse API"
APP_ENV=production
DEBUG=false

# ─── Container Image Registry & Immutable Tag ─────────────────────────
# Strictly avoid :latest; use the Git commit SHA from the CD release or semantic version.
IMAGE_REGISTRY=ghcr.io/i243137-oss
IMAGE_TAG=v1.0.0

# ─── Ingress Ports (Edge Network) ─────────────────────────────────────
# Only frontend port 80 is exposed publicly. Backend port 8000 is internal.
FRONTEND_PORT=80
BACKEND_PORT=8000

# ─── PostgreSQL Database (Production) ─────────────────────────────────
# Isolated on internal Docker network; no host port binding.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PRODUCTION_SECRET_PASSWORD_MIN_32_CHARS
POSTGRES_DB=civicpulse

# ─── Redis Cache & Rate Limiting (Production) ─────────────────────────
# Isolated on internal Docker network; AOF persistence enabled.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_REDIS_PASSWORD
REDIS_DB=0

# ─── AI Triage Provider ───────────────────────────────────────────────
# In production, use "rules", "simulated", or "llm" (with Groq API key)
TRIAGE_PROVIDER=rules
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# ─── Compose Project Identifier ───────────────────────────────────────
COMPOSE_PROJECT_NAME=civicpulse
